; PHY v4.0.0 — Pure QF_LIA Noether Conservation, Fracton Mobility & Theory Falsification
(set-logic QF_LIA)

(declare-const q0 Int) (declare-const q1 Int) (declare-const q2 Int) (declare-const q3 Int)
(declare-const qn0 Int) (declare-const qn1 Int) (declare-const qn2 Int) (declare-const qn3 Int)
(declare-const j0 Int) (declare-const j1 Int) (declare-const j2 Int) (declare-const j3 Int)
(declare-const j_in Int) (declare-const j_out Int)

; CHECK 1: Anti-vacuity — nontrivial conserved density & currents on a 4-site periodic ring (expect SAT)
(push)
(assert (not (= q0 0)))
(assert (not (= j0 0)))
(assert (= (- qn0 q0) (- j0 j3)))
(assert (= (- qn1 q1) (- j1 j0)))
(assert (= (- qn2 q2) (- j2 j1)))
(assert (= (- qn3 q3) (- j3 j2)))
(assert (= (+ qn0 qn1 qn2 qn3) (+ q0 q1 q2 q3)))
(check-sat)
(pop)

; CHECK 2: Discrete Noether telescoping theorem on periodic 4-ring (expect UNSAT)
(push)
(assert (= (- qn0 q0) (- j0 j3)))
(assert (= (- qn1 q1) (- j1 j0)))
(assert (= (- qn2 q2) (- j2 j1)))
(assert (= (- qn3 q3) (- j3 j2)))
(assert (not (= (+ qn0 qn1 qn2 qn3) (+ q0 q1 q2 q3))))
(check-sat)
(pop)

; CHECK 3: Honest Theory Falsification — open-boundary flux mismatch leaks global charge (expect SAT)
(push)
(assert (= (- qn0 q0) (- j0 j_in)))
(assert (= (- qn1 q1) (- j1 j0)))
(assert (= (- qn2 q2) (- j2 j1)))
(assert (= (- qn3 q3) (- j_out j2)))
(assert (not (= j_in j_out)))
(assert (not (= (+ qn0 qn1 qn2 qn3) (+ q0 q1 q2 q3))))
(check-sat)
(pop)

(declare-const dq0 Int) (declare-const dq1 Int) (declare-const dq2 Int) (declare-const dq3 Int)
(declare-const hop Int)

; CHECK 4: Fracton dipole no-go — nonzero single-charge hop dq=(0,-hop,+hop,0) cannot conserve dipole moment (expect UNSAT)
(push)
(assert (not (= hop 0)))
(assert (= dq0 0))
(assert (= dq1 (- hop)))
(assert (= dq2 hop))
(assert (= dq3 0))
(assert (= (+ dq0 dq1 dq2 dq3) 0))
(assert (= (+ (* 0 dq0) (* 1 dq1) (* 2 dq2) (* 3 dq3)) 0))
(check-sat)
(pop)

; CHECK 5: Fracton quadrupole witness — symmetric (+1,-2,+1) move preserves both charge Q and dipole D (expect SAT)
(push)
(assert (not (= dq0 0)))
(assert (= dq3 0))
(assert (= (+ dq0 dq1 dq2 dq3) 0))
(assert (= (+ (* 0 dq0) (* 1 dq1) (* 2 dq2) (* 3 dq3)) 0))
(check-sat)
(pop)
